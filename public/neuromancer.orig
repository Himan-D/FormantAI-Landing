"14" height="14" fill="var(--color-green)"></rect><text x="722" y="111" style="font-family:var(--font-family-departure-mono);font-size:12px;fill:var(--color-primary-surface)">NEUROMANCER XR</text></g></svg></div></div><div class="sc-7e990ece-4 gfCBvM">LOCOMO EVALS — ACCURACY BY CATEGORY</div></div><div class="sc-7e990ece-5 lmbljG"><div class="sc-7e990ece-6 iEeoMR"><h3 style="margin-bottom:0.5rem;letter-spacing:-0.02em" class="sc-79abb59d-0 hdTyJj">EVALUATION RESULTS</h3><p class="sc-79abb59d-0 cphufP">Performance on the LoCoMo Benchmark</p></div><div class="sc-7e990ece-7 gaNGEO"><div class="sc-7e990ece-8 kKmzLl"><div class="sc-7e990ece-9 jPYchd"><div><h5 class="sc-79abb59d-0 icXsrW">Neuromancer XR — Overall</h5></div><div class="sc-7e990ece-10 bbeEcA">86.9%</div></div><div class="sc-7e990ece-11 fiQLAG"><div class="sc-7e990ece-12 eNJFSN"><span class="sc-7e990ece-13 ljBzuH">Single-Hop</span><span class="sc-7e990ece-14 gpSBdA">81.0%</span></div><div class="sc-7e990ece-12 eNJFSN"><span class="sc-7e990ece-13 ljBzuH">Temporal</span><span class="sc-7e990ece-14 gpSBdA">89.4%</span></div><div class="sc-7e990ece-12 eNJFSN"><span class="sc-7e990ece-13 ljBzuH">Multi-Hop</span><span class="sc-7e990ece-14 gpSBdA">84.4%</span></div><div class="sc-7e990ece-12 eNJFSN"><span class="sc-7e990ece-13 ljBzuH">Open-Domain Knowledge</span><span class="sc-7e990ece-14 gpSBdA">88.4%</span></div></div></div></div><div class="sc-7e990ece-15 hVxIhu"><p class="sc-79abb59d-0 eQzWtx"><strong>Evaluation Details:</strong> Evaluation conducted on the LoCoMo dataset using a custom LLM-as-judge scoring method. Scores represent Honcho&#x27;s average accuracy on LoCoMo question-answering when powered by Neuromancer XR.</p></div></div><div class="sc-7e990ece-16 bYqoHx"><div class="sc-7e990ece-17 geqlvi"><svg fill="none" height="10" viewBox="0 0 9 10" width="9" xmlns="http://www.w3.org/2000/svg"><path d="M3.726 9.198V5.112H0V4.104H3.726V0H4.752V4.104H8.496V5.112H4.752V9.198H3.726Z" fill="currentColor"></path