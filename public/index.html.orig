V4.104H8.496V5.112H4.752V9.198H3.726Z" fill="currentColor"></path></svg><svg fill="none" height="10" viewBox="0 0 9 10" width="9" xmlns="http://www.w3.org/2000/svg"><path d="M3.726 9.198V5.112H0V4.104H3.726V0H4.752V4.104H8.496V5.112H4.752V9.198H3.726Z" fill="currentColor"></path></svg><svg fill="none" height="10" viewBox="0 0 9 10" width="9" xmlns="http://www.w3.org/2000/svg"><path d="M3.726 9.198V5.112H0V4.104H3.726V0H4.752V4.104H8.496V5.112H4.752V9.198H3.726Z" fill="currentColor"></path></svg><svg fill="none" height="10" viewBox="0 0 9 10" width="9" xmlns="http://www.w3.org/2000/svg"><path d="M3.726 9.198V5.112H0V4.104H3.726V0H4.752V4.104H8.496V5.112H4.752V9.198H3.726Z" fill="currentColor"></path></svg><svg fill="none" height="10" viewBox="0 0 9 10" width="9" xmlns="http://www.w3.org/2000/svg"><path d="M3.726 9.198V5.112H0V4.104H3.726V0H4.752V4.104H8.496V5.112H4.752V9.198H3.726Z" fill="currentColor"></path></svg></span><div class="sc-d81dc29e-0 fvREBp"><div class="sc-ad925a37-0 bRnVoG"><div class="sc-eb0d74f6-0 yENyN"><h2 class="sc-79abb59d-0 cphufP">About</h2></div><div class="sc-ad925a37-1 hUNxih"><p class="sc-79abb59d-0 cphufP">Plastic is an engineering-driven AI lab building at the intersection of machine learning and cognitive science.</p><p style="margin-top:1rem" class="sc-79abb59d-0 cphufP">Our focus is developing<!-- --> <a href="https://honcho.dev" target="_blank" rel="noopener noreferrer" class="sc-d81dc29e-1 jEWSET">Honcho</a>, an AI-native memory solution powered by our state-of-the-art<!-- --> <a href="https://plasticlabs.ai/neuromancer" target="_blank" rel="noopener noreferrer" class="sc-d81dc29e-1 jEWSET">reasoning models</a>. Honcho is a continual learning system for modeling personal identity, and soon a shared context layer for individual alignment.</p></div><div class="sc-ad925a37-2 jPknZT"><a href="https://plasticlabs.ai/blog" rel="noopener" target="_blank" class="sc-15c6e69-1 lbtcPq"><span class="sc-f58772f6-0 gyxnmJ">Learn more</span></a></d